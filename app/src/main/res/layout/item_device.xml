<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/dp64"
    android:paddingLeft="@dimen/dp24"
    android:paddingRight="@dimen/dp24"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp12">

    <ImageView
        android:id="@+id/item_device_icon"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_baseline_devices"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_device_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp16"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/colorPrimaryText"
        android:textSize="@dimen/sp16"
        app:layout_constraintLeft_toRightOf="@id/item_device_icon"
        app:layout_constraintRight_toLeftOf="@id/item_device_arrow"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_device_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginTop="@dimen/dp2"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/colorSecondaryText"
        android:textSize="@dimen/sp14"
        app:layout_constraintLeft_toRightOf="@id/item_device_icon"
        app:layout_constraintRight_toLeftOf="@id/item_device_arrow"
        app:layout_constraintTop_toBottomOf="@id/item_device_name" />

    <ImageView
        android:id="@+id/item_device_arrow"
        android:layout_width="@dimen/dp24"
        android:layout_height="@dimen/dp24"
        android:layout_marginStart="@dimen/dp8"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
